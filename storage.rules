rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos
    match /profile_photos/{uid}/{fileName} {
      // Users can read any profile photo
      allow read: if request.auth != null;

      // Users can upload their own profile photo (max 2MB)
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.startsWith('image/');

      // Users can delete their own profile photo
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Company logos
    match /company_logos/{companyId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.startsWith('image/');
      allow delete: if request.auth != null;
    }

    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
